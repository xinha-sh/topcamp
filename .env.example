# Copy to .env and fill in secrets. Never commit .env.
# See MIGRATION_NOTES.md "Config + local dev plan".

# PostgreSQL (also used by the DBOS system database)
DATABASE_URL=postgres://topcamp:topcamp@localhost:5432/topcamp

# Rails-compatible cookie crypto (must verify pre-migration cookies)
SECRET_KEY_BASE=change-me-in-production

# S3-compatible object storage (RustFS 1.0)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change-me-in-production
RUSTFS_BUCKET=topcamp
RUSTFS_REGION=us-east-1

# Web Push (leave empty to disable, as upstream does without VAPID keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Absolute-URL base for avatars, webhooks payload links, mail
APP_URL=http://localhost:3000

# Single HTTP listener (front/Thruster split deleted)
PORT=3000

# Logging (tracing EnvFilter)
RUST_LOG=info
TOPCAMP_LOG=
